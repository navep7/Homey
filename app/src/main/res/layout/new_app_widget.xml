<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rl_widget_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_glass"
    android:orientation="vertical"
    android:theme="@style/Theme.Material3.DynamicColors.Light">


    <RelativeLayout
        android:id="@+id/rl_clocks"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:background="@drawable/gradient_glass_flatbottom">

        <TextView
            android:id="@+id/tx_wish"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true"
            android:layout_gravity="center"
            android:text="a Wish..."
            android:textSize="33sp"
            android:textStyle="bold|italic"
            tools:ignore="HardcodedText" />

        <ImageButton
            android:id="@+id/fab_wifi"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_below="@+id/tx_wish"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="@dimen/fab_margin"
            android:layout_marginEnd="@dimen/fab_margin"
            android:background="@drawable/transparent_bg"
            android:scaleType="fitXY"
            android:src="@drawable/wifi_off" />


        <AnalogClock
            android:id="@+id/a_clock"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_below="@+id/tx_wish"
            android:dial="@drawable/walp_icon"
            android:hand_second="@drawable/s_hand" />

        <android.widget.TextClock
            android:id="@+id/clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/tx_wish"
            android:layout_toEndOf="@+id/a_clock"
            android:format12Hour="k:mm:ss"
            android:textSize="35sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tx_day_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/clock"
            android:layout_marginEnd="@dimen/fab_margin"
            android:layout_toEndOf="@+id/a_clock"
            android:text="Day.. Date"
            android:textSize="35sp"
            android:textStyle="bold"
            tools:ignore="HardcodedText" />

        <TextView
            android:id="@+id/tx_placeandweather"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/tx_day_date"
            android:layout_centerHorizontal="true"
            android:gravity="center"
            android:text="Place ↺ Weather"
            android:textSize="21sp"
            android:textStyle="bold"
            tools:ignore="HardcodedText" />


        <RelativeLayout
            android:id="@+id/rl_news"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:layout_marginTop="1dp"
            android:layout_below="@+id/tx_placeandweather">


            <ImageButton
                android:id="@+id/imgbtn_news_prev"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_alignParentStart="true"
                android:background="@android:color/transparent"
                android:foregroundGravity="center"
                android:src="@android:drawable/ic_media_previous"/>

            <TextView
                android:id="@+id/tx_news"
                android:layout_toRightOf="@+id/imgbtn_news_prev"
                android:layout_toLeftOf="@+id/imgbtn_news_next"
                android:maxLines="2"
                android:textSize="15sp"
                android:textStyle="bold"
                android:ellipsize="end"
                android:layout_width="match_parent"
                android:layout_height="45dp"/>


            <ImageButton
                android:id="@+id/imgbtn_news_next"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_alignParentEnd="true"
                android:background="@android:color/transparent"
                android:foregroundGravity="center"
                android:src="@android:drawable/ic_media_next"/>

        </RelativeLayout>



    </RelativeLayout>




    <LinearLayout
        android:id="@+id/ll_apps"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/rl_clocks"
        android:layout_marginStart="@dimen/fab_margin"
        android:layout_marginTop="3dp"
        android:layout_marginEnd="@dimen/fab_margin"
        android:gravity="center">

        <ImageView
            android:id="@+id/imgv_add1"
            android:layout_width="55dp"
            android:layout_height="55dp"
            android:layout_margin="5dp"
            android:background="?android:attr/selectableItemBackground" />

        <ImageView
            android:id="@+id/imgv_add2"
            android:layout_width="55dp"
            android:layout_height="55dp"
            android:layout_margin="5dp"
            android:background="?android:attr/selectableItemBackground" />

        <ImageView
            android:id="@+id/imgv_add3"
            android:layout_width="55dp"
            android:layout_height="55dp"
            android:layout_margin="5dp"
            android:background="?android:attr/selectableItemBackground" />

        <ImageView
            android:id="@+id/imgv_add4"
            android:layout_width="55dp"
            android:layout_height="55dp"
            android:layout_margin="5dp"
            android:background="?android:attr/selectableItemBackground" />

        <ImageView
            android:id="@+id/imgv_add5"
            android:layout_width="55dp"
            android:layout_height="55dp"
            android:layout_margin="5dp"
            android:background="?android:attr/selectableItemBackground" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_contacts"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/ll_apps"
        android:layout_marginStart="@dimen/fab_margin"
        android:layout_marginTop="3dp"
        android:layout_marginEnd="@dimen/fab_margin"
        android:gravity="center">


        <RelativeLayout
            android:id="@+id/rl_contact1"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="5dp">

            <ImageView
                android:id="@+id/imgv_contact1"
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:background="?android:attr/selectableItemBackground"
                android:scaleType="fitXY" />

            <TextView
                android:id="@+id/tx_c1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignStart="@+id/imgv_contact1"
                android:layout_alignBottom="@+id/imgv_contact1"
                android:layout_margin="1dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxWidth="55sp"
                android:maxLines="1"
                android:textColor="?attr/colorPrimaryInverse"
                android:textSize="25sp"
                android:textStyle="bold" />

        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/rl_contact2"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="5dp">

            <ImageView
                android:id="@+id/imgv_contact2"
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:background="?android:attr/selectableItemBackground"
                android:scaleType="fitXY" />

            <TextView
                android:id="@+id/tx_c2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignStart="@+id/imgv_contact2"
                android:layout_alignBottom="@+id/imgv_contact2"
                android:layout_margin="1dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxWidth="55sp"
                android:maxLines="1"
                android:textColor="?attr/colorPrimaryInverse"
                android:textSize="25sp"
                android:textStyle="bold" />

        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/rl_contact3"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="5dp">

            <ImageView
                android:id="@+id/imgv_contact3"
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:background="?android:attr/selectableItemBackground"
                android:scaleType="fitXY" />

            <TextView
                android:id="@+id/tx_c3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignStart="@+id/imgv_contact3"
                android:layout_alignBottom="@+id/imgv_contact3"
                android:layout_margin="1dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxWidth="55sp"
                android:maxLines="1"
                android:textColor="?attr/colorPrimaryInverse"
                android:textSize="25sp"
                android:textStyle="bold" />

        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/rl_contact4"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="5dp">

            <ImageView
                android:id="@+id/imgv_contact4"
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:background="?android:attr/selectableItemBackground"
                android:scaleType="fitXY" />

            <TextView
                android:id="@+id/tx_c4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignStart="@+id/imgv_contact4"
                android:layout_alignBottom="@+id/imgv_contact4"
                android:layout_margin="1dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxWidth="55sp"
                android:maxLines="1"
                android:textColor="?attr/colorPrimaryInverse"
                android:textSize="25sp"
                android:textStyle="bold" />

        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/rl_contact5"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="5dp">

            <ImageView
                android:id="@+id/imgv_contact5"
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:background="?android:attr/selectableItemBackground"
                android:scaleType="fitXY" />

            <TextView
                android:id="@+id/tx_c5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignStart="@+id/imgv_contact5"
                android:layout_alignBottom="@+id/imgv_contact5"
                android:layout_margin="1dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxWidth="55sp"
                android:maxLines="1"
                android:textColor="?attr/colorPrimaryInverse"
                android:textSize="25sp"
                android:textStyle="bold" />

        </RelativeLayout>


    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressBar_cyclic"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/ll_contacts"
        android:layout_toRightOf="@+id/imgbtn_conf"
        android:layout_marginStart="30dp"
        android:minWidth="50dp"
        android:indeterminate="true"
        android:indeterminateTintMode="src_atop"
        android:indeterminateTint="?attr/colorPrimaryInverse"
        android:minHeight="50dp"
        android:visibility="invisible" />


    <ImageButton
        android:id="@+id/imgbtn_lock1"
        android:visibility="invisible"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_below="@+id/ll_contacts"
        android:layout_alignParentStart="true"
        android:layout_marginStart="50dp"
        android:outlineSpotShadowColor="?attr/colorPrimary"
        android:scaleType="fitXY"
        android:src="@android:drawable/ic_lock_lock" />

    <Button
        android:id="@+id/imgbtn_lock"
        android:text="Lock"
        android:textStyle="bold"
        android:textColor="?attr/colorPrimaryInverse"
        android:background="@drawable/rounded_corner"
        android:layout_below="@+id/ll_contacts"
        android:layout_alignParentStart="true"
        android:layout_marginStart="50dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <Button
        android:id="@+id/imgbtn_conf"
        android:text="Search"
        android:textStyle="bold"
        android:textColor="?attr/colorPrimaryInverse"
        android:background="@drawable/rounded_corner"
        android:layout_centerHorizontal="true"
        android:layout_below="@+id/ll_contacts"
        android:layout_marginStart="50dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <Button
        android:id="@+id/imgbtn_set"
        android:text="Refresh"
        android:textStyle="bold"
        android:textColor="?attr/colorPrimaryInverse"
        android:background="@drawable/rounded_corner"
        android:layout_below="@+id/ll_contacts"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="50dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <RelativeLayout
        android:id="@+id/rl_steps"
        android:layout_below="@+id/imgbtn_set"
        android:layout_margin="@dimen/fab_margin"
        android:background="@drawable/rounded_corner_gray"
        android:layout_width="match_parent"
        android:layout_height="35dp">


        <ImageButton
            android:id="@+id/imgv_steps"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_marginStart="@dimen/fab_margin"
            android:layout_alignParentStart="true"
            android:background="@android:color/transparent"
            android:scaleType="fitXY"
            android:src="@drawable/steps" />

        <TextView
            android:id="@+id/tx_steps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@+id/imgv_steps"
            android:layout_marginStart="@dimen/fab_margin"
            android:textSize="25sp"
            android:textStyle="bold"
            tools:ignore="HardcodedText" />

        <TextView
            android:id="@+id/vertical_divider"
            android:layout_width="5dp"
            android:visibility="invisible"
            android:layout_toRightOf="@+id/tx_steps"
            android:layout_marginStart="@dimen/fab_margin"
            android:layout_marginEnd="@dimen/fab_margin"
            android:layout_height="match_parent"
            android:background="@android:color/black" />

        <TextView
            android:id="@+id/tx_n_steps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toRightOf="@+id/vertical_divider"
            android:layout_marginStart="@dimen/fab_margin"
            android:textSize="25sp"
            android:textStyle="bold" />

    </RelativeLayout>

    <TextView
        android:id="@+id/tx_desc_walltype"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:background="@drawable/gradient_glass_flattop"
        android:text="..."
        android:textStyle="bold" />



</RelativeLayout>