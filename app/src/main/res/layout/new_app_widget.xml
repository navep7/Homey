<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rl_widget_layout"
    android:background="@drawable/gradient_glass"
    android:theme="@style/Theme.Material3.DynamicColors.DayNight"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        android:id="@+id/time_text_view"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:textColor="?attr/colorPrimary"
        android:textSize="35sp" />

    <android.widget.TextClock
        android:id="@+id/clock"
        android:layout_centerHorizontal="true"
        android:layout_below="@+id/time_text_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:format12Hour="k:mm:ss"
        android:format24Hour="k:mm:ss"
        android:textColor="?attr/colorPrimaryContainer"
        android:textSize="50sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/date_text_view"
        android:layout_centerHorizontal="true"
        android:layout_below="@+id/clock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:textColor="?attr/colorPrimary"
        android:textSize="35sp" />

    <LinearLayout
        android:id="@+id/ll_apps"
        android:layout_below="@+id/date_text_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/fab_margin"
        android:gravity="center">

        <ImageView
            android:id="@+id/imgv_add1"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_margin="5dp" />

        <ImageView
            android:id="@+id/imgv_add2"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_margin="5dp" />

        <ImageView
            android:id="@+id/imgv_add"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:src="@drawable/add_icon" />

        <ImageView
            android:id="@+id/imgv_add3"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_margin="5dp" />

        <ImageView
            android:id="@+id/imgv_add4"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_margin="5dp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_contacts"
        android:layout_below="@+id/ll_apps"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_margin="@dimen/fab_margin">


        <LinearLayout
            android:layout_margin="@dimen/fab_margin"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tx_c1"
                android:textColor="?attr/colorOnPrimary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="25sp"
                android:maxLines="1"
                android:maxWidth="55sp"
                android:ellipsize="end"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/imgv_contact1"
                android:scaleType="fitXY"
                android:layout_width="50dp"
                android:layout_height="50dp" />
        </LinearLayout>

        <LinearLayout
            android:orientation="vertical"
            android:layout_margin="@dimen/fab_margin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tx_c2"
                android:textColor="?attr/colorOnPrimary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="25sp"
                android:maxLines="1"
                android:maxWidth="55sp"
                android:ellipsize="end"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/imgv_contact2"
                android:scaleType="fitXY"
                android:layout_width="50dp"
                android:layout_height="50dp" />
        </LinearLayout>

        <LinearLayout
            android:orientation="vertical"
            android:layout_margin="@dimen/fab_margin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tx_c3"
                android:textColor="?attr/colorOnPrimary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="25sp"
                android:maxLines="1"
                android:maxWidth="55sp"
                android:ellipsize="end"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/imgv_contact3"
                android:scaleType="fitXY"
                android:layout_width="50dp"
                android:layout_height="50dp" />
        </LinearLayout>

        <LinearLayout
            android:orientation="vertical"
            android:layout_margin="@dimen/fab_margin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tx_c4"
                android:textColor="?attr/colorOnPrimary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="25sp"
                android:maxLines="1"
                android:maxWidth="55sp"
                android:ellipsize="end"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/imgv_contact4"
                android:scaleType="fitXY"
                android:layout_width="50dp"
                android:layout_height="50dp" />
        </LinearLayout>


    </LinearLayout>


</RelativeLayout>